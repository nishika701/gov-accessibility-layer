# AWS Credentials for Amazon Polly & Amazon Transcribe
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1

# S3 Bucket for Amazon Transcribe audio uploads
AWS_S3_BUCKET=your_transcribe_s3_bucket_name

# Optional: Preferred TTS provider ('auto', 'polly', or 'gtts')
# 'auto' will try Amazon Polly first and fall back to gTTS if credentials are missing
TTS_PROVIDER=auto
