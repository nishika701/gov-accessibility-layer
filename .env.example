# ==============================================================================
# Gov Accessibility Layer - Environment Variables Documentation (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.
# Example: cp .env.example .env

# ------------------------------------------------------------------------------
# 1. AWS Authentication & Identity
# ------------------------------------------------------------------------------
# AWS_PROFILE:
#   The named profile in ~/.aws/credentials or ~/.aws/config.
#   Used when authenticating via AWS SSO or AWS IAM Identity Center.
#   Default: gov-accessibility
AWS_PROFILE=gov-accessibility

# AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY:
#   Direct IAM user credentials with permissions for S3, Textract, Polly, SageMaker, Transcribe.
#   Only needed if not using an AWS SSO profile.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS_DEFAULT_REGION:
#   The AWS region where your resources (S3 buckets, SageMaker endpoints) are hosted.
#   Example: us-east-1, ap-south-1
AWS_DEFAULT_REGION=us-east-1


# ------------------------------------------------------------------------------
# 2. Amazon S3 Storage
# ------------------------------------------------------------------------------
# AWS_S3_BUCKET:
#   The primary S3 bucket used to store uploaded PDF documents for Textract OCR,
#   processed results, and output audio files.
AWS_S3_BUCKET=gov-accessibility-layer-devforge-237303364767-us-east-1-an

# TRANSCRIBE_S3_BUCKET:
#   (Optional) Bucket for storing input audio files for Amazon Transcribe speech-to-text.
#   Usually the same as AWS_S3_BUCKET.
TRANSCRIBE_S3_BUCKET=gov-accessibility-layer-devforge-237303364767-us-east-1-an


# ------------------------------------------------------------------------------
# 3. Amazon SageMaker Endpoints
# ------------------------------------------------------------------------------
# SAGEMAKER_ENDPOINT_NAME:
#   Name of your deployed SageMaker endpoint running the text simplification and Q&A LLM.
SAGEMAKER_ENDPOINT_NAME=gov-accessibility-llm-endpoint

# SAGEMAKER_EXPLAIN_ENDPOINT:
#   (Optional) Dedicated endpoint for POST /explain (document simplification).
#   Defaults to SAGEMAKER_ENDPOINT_NAME if not specified.
SAGEMAKER_EXPLAIN_ENDPOINT=gov-accessibility-llm-endpoint

# SAGEMAKER_QA_ENDPOINT:
#   (Optional) Dedicated endpoint for POST /question and POST /check-answer.
#   Defaults to SAGEMAKER_ENDPOINT_NAME if not specified.
SAGEMAKER_QA_ENDPOINT=gov-accessibility-llm-endpoint


# ------------------------------------------------------------------------------
# 4. Text-to-Speech (TTS) Provider
# ------------------------------------------------------------------------------
# TTS_PROVIDER:
#   Controls which text-to-speech engine produces citizen audio.
#   Options:
#     - 'auto'  : Tries Amazon Polly first; falls back to free gTTS if credentials missing.
#     - 'polly' : Forces Amazon Polly neural TTS (requires valid AWS credentials).
#     - 'gtts'  : Forces Google Text-to-Speech (offline / free, no AWS needed).
TTS_PROVIDER=auto


# ------------------------------------------------------------------------------
# 5. Local Fallback & Development (Ollama)
# ------------------------------------------------------------------------------
# OLLAMA_URL:
#   Local Ollama server HTTP API URL.
#   Used as an automated local fallback when SageMaker endpoints are offline.
OLLAMA_URL=http://localhost:11434/api/generate

# OLLAMA_MODEL:
#   The local model installed in Ollama to use for text simplification.
#   Example: llama3.1, mistral, gemma:2b
OLLAMA_MODEL=llama3.1
